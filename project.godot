; Engine configuration file.
; Gameish: EDEN//FALL
config_version=5

[application]
config/name="Gameish: EDEN//FALL"
config/version="0.5.0"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"
boot_splash/bg_color=Color(0.027, 0.043, 0.047, 1)
boot_splash/image="res://assets/generated/ui/boot_splash.png"
boot_splash/fullsize=true

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/dpi/allow_hidpi=true
window/handheld/orientation=0
window/ios/hide_home_indicator=true

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
renderer/rendering_method.web="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/canvas_textures/default_texture_filter=0
limits/time/time_rollover_secs=3600

[audio]
default_bus_layout="res://default_bus_layout.tres"
driver/enable_input=false

[internationalization]
locale/fallback="en"
